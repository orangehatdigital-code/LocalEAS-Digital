# ========================================================
# LocalEAS Digital - Çevre Değişkenleri Şablonu (.env.example)
# ========================================================
# Bu dosyayı '.env.local' olarak kopyalayıp kendi sisteminize göre düzenleyin:
# cp .env.example .env.local

# --------------------------------------------------------
# 1. Sunucu & Ağ Yapılandırması
# --------------------------------------------------------
PORT=3000
HOST=0.0.0.0

# --------------------------------------------------------
# 2. Çalışma Alanı & Proje Dizini (WSL2 / Linux)
# --------------------------------------------------------
# Expo / React Native projelerinizin bulunduğu ana dizin.
# Belirtilmezse varsayılan olarak kullanıcının '~/builds' dizini kullanılır.
BUILDS_ROOT=~/builds

# --------------------------------------------------------
# 3. Android SDK & Java Yolları (İsteğe Bağlı)
# --------------------------------------------------------
# Sisteminizde standart dışı bir dizinde kuruluysa aktif edin:
# JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
# ANDROID_HOME=/home/kullaniciadi/android-sdk

# --------------------------------------------------------
# 4. Windows Başlatıcı Ayarları (scripts/Dashboard-Baslat.bat)
# --------------------------------------------------------
# Windows üzerinden başlatırken hedef WSL2 dağıtımı ve kullanıcı adı:
WSL_DISTRO=Ubuntu-22.04
WSL_USER=kullaniciadi
